# SECURITY: Environment Configuration Template
# Copy to .env and fill with actual values. NEVER commit .env file!
# Use strong, randomly generated values for production

# ===== Database Configuration =====
# Set secure database credentials
DB_URL=jdbc:mysql://localhost:3306/dayflow_hrms?createDatabaseIfNotExist=true&useSSL=true&allowPublicKeyRetrieval=false&serverTimezone=UTC&requireSSL=true
DB_USERNAME=dayflow_user
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD_12345

# ===== JWT Configuration =====
# Generate JWT_SECRET with: openssl rand -base64 32
# Store securely in production (e.g., AWS Secrets Manager, HashiCorp Vault)
JWT_SECRET=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_BASE64_32
JWT_EXPIRATION=86400000

# ===== CORS Configuration =====
# Restrict to your actual frontend URL in production
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ===== Email Verification =====
# MAIL_ENABLED=false logs verification codes to the server console (dev mode).
# Set true with real SMTP credentials for actual email delivery.
#
# --- Gmail setup (5 minutes) ---
# 1. Enable 2-Step Verification on your Google account:
#    https://myaccount.google.com/security
# 2. Create an App Password: https://myaccount.google.com/apppasswords
#    (pick "Mail", copy the 16-character password it shows you)
# 3. Fill MAIL_USERNAME with your Gmail address and MAIL_PASSWORD with the
#    App Password - NOT your normal login password.
# 4. MAIL_FROM must be the SAME Gmail address (Gmail rejects other senders).
MAIL_ENABLED=false
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=CHANGE_ME_16_CHAR_GMAIL_APP_PASSWORD
MAIL_FROM=your_email@gmail.com
VERIFICATION_TTL=15

# ===== Frontend Configuration =====
VITE_API_BASE_URL=http://localhost:8080/api
VITE_USE_MOCK=false

# ===== Security Flags =====
# Enable HTTPS in production
NODE_ENV=development
